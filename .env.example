# ─── Phase 1 — Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=           # Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase → Settings → API → anon key
SUPABASE_SERVICE_ROLE_KEY=          # Supabase → Settings → API → service_role key

# DRY_RUN — set true locally to skip all real API calls (fixture data only)
DRY_RUN=true

# ─── Phase 2 — Agents ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # console.anthropic.com → API keys
TAVILY_API_KEY=                     # tavily.com → dashboard → API keys
ELEVENLABS_API_KEY=                 # elevenlabs.io → profile → API key

# ─── Supabase CLI (not a Next.js var — CLI use only) ─────────────────────────
SUPABASE_DB_PASSWORD=               # Supabase → Settings → Database → password

# ─── Phase 4 — Auth + YouTube OAuth ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                # e.g. http://localhost:3000 (dev) or https://your-domain.com (prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # clerk.com → API keys
CLERK_SECRET_KEY=                   # clerk.com → API keys
CLERK_WEBHOOK_SECRET=               # clerk.com → Webhooks → signing secret (optional for local dev)
YOUTUBE_CLIENT_ID=                  # Google Cloud Console → Credentials → OAuth 2.0
YOUTUBE_CLIENT_SECRET=              # Google Cloud Console → Credentials → OAuth 2.0
YOUTUBE_TOKEN_ENCRYPTION_KEY=       # 64 hex chars (32 bytes) — generate: openssl rand -hex 32

# ─── Phase 5 — Billing ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                  # stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # stripe.com → Developers → API keys
STRIPE_WEBHOOK_SECRET=              # stripe.com → Webhooks → signing secret

# ─── Phase 6 — Observability ──────────────────────────────────────────────────
SENTRY_DSN=                         # sentry.io → project → Settings → DSN
NEXT_PUBLIC_SENTRY_DSN=             # same value as SENTRY_DSN
BETTERSTACK_SOURCE_TOKEN=           # betterstack.com → Logs → source → Source token
